# Auth — single user
VITE_APP_USERNAME=nishanth
VITE_APP_PASSWORD=change-me

# Google Drive — OAuth Client ID from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com

# Google Gemini API (free tier — https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash-lite

# UPI auto-import — Cloudflare Worker URL + shared secret
# (Get URL after `wrangler deploy`; secret must match what you `wrangler secret put`)
VITE_UPI_API_URL=https://nexuslife-upi-receiver.YOUR-SUBDOMAIN.workers.dev
VITE_UPI_API_SECRET=pick-a-long-random-string

# Telegram reminders — second Cloudflare Worker, applies button-tap actions
VITE_TELEGRAM_API_URL=https://nexuslife-telegram-reminder.YOUR-SUBDOMAIN.workers.dev
VITE_TELEGRAM_API_SECRET=same-as-SHARED_SECRET-on-that-worker
