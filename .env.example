# Public browser configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional public configuration only
VITE_GEMINI_PROXY_URL=https://your-secure-ai-proxy.example.com
VITE_GEMINI_MODEL=google/gemini-2.0-flash-exp:free

# Local RLS test process only — never expose or prefix with VITE_
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server-side secrets belong in Supabase/Vercel server environments:
# GEMINI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# SUPABASE_SERVICE_ROLE_KEY=
